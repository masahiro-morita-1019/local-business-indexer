{
  "name": "local-business-indexer",
  "version": "0.1.0",
  "description": "Google Maps × industry を調査し HP未保有企業を Notion に集約する営業先リスト構築ツール",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "indexer": "tsx src/cli.ts",
    "setup:notion": "tsx scripts/setup-notion-db.ts",
    "migrate:notion": "tsx scripts/migrate-notion-db.ts",
    "preview": "astro dev --root src/generator/site",
    "generate": "astro build --root src/generator/site",
    "site": "pnpm indexer build-data --category 外壁塗装 --min-priority 中 && pnpm preview",
    "typecheck": "tsc --noEmit",
    "typecheck:site": "astro check --root src/generator/site",
    "lint": "biome check src scripts",
    "format": "biome format --write src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@astrojs/react": "^5.0.5",
    "@notionhq/client": "^2.2.15",
    "astro": "^6.3.6",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "p-limit": "^5.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.93.1"
  }
}
