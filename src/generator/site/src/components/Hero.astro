---
import type { Target } from '../data/types.ts';

interface Props {
  target: Target;
  eyebrow: string;
  catchphrase: string;
  subCatchphrase: string;
  note: string;
  mediaSrc: string;
  mediaAlt: string;
  mediaCaption: string[];
}
const { target, eyebrow, catchphrase, subCatchphrase, note, mediaSrc, mediaAlt, mediaCaption } =
  Astro.props;
const telHref = target.phone ? `tel:${target.phone.replace(/-/g, '')}` : null;
const ratingDisplay =
  target.rating != null && target.reviewCount != null && target.reviewCount > 0
    ? `Google評価 ${target.rating.toFixed(1)} (${target.reviewCount}件)`
    : null;
---
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">{eyebrow}</p>
      <h1 class="hero__title">{catchphrase}</h1>
      <p class="hero__lede">{subCatchphrase}</p>
      <div class="hero__signals" aria-label="掲載している事実情報">
        <span>{target.name}</span>
        <span>{target.area}</span>
        {target.phone && <span>TEL {target.phone}</span>}
        {ratingDisplay && <span>{ratingDisplay}</span>}
      </div>
      <div class="hero__cta">
        {telHref && (
          <a class="btn" href={telHref}>
            {target.phone} に電話する
          </a>
        )}
        <a class="btn btn--ghost" href="#contact">アクセス・営業時間を見る</a>
        {target.googleMapsUrl && (
          <a class="btn btn--ghost" href={target.googleMapsUrl} target="_blank" rel="noopener">
            Google Maps
          </a>
        )}
      </div>
      <p class="hero__note">{note}</p>
    </div>
    <div class="hero__media" aria-label="住宅外観の汎用イメージ">
      <img
        src={mediaSrc}
        alt={mediaAlt}
        loading="eager"
      />
      <div class="hero__mediaCaption">
        {mediaCaption.map((line) => <span>{line}</span>)}
      </div>
    </div>
  </div>
</section>
<style>
  .hero {
    background:
      linear-gradient(135deg, rgba(23, 50, 77, 0.96), rgba(31, 111, 74, 0.78)),
      var(--c-navy);
    color: #ffffff;
    padding: 4.5rem 0;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 0.82fr);
    gap: 3rem;
    align-items: center;
  }
  .hero__content {
    max-width: 42rem;
  }
  .hero__eyebrow {
    margin: 0 0 0.75rem;
    color: #cfe3d7;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .hero__title {
    margin: 0 0 1rem;
    font-size: clamp(2.15rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: 0;
  }
  .hero__lede {
    margin: 0 0 1.5rem;
    color: #edf5ef;
    font-size: clamp(1rem, 2vw, 1.15rem);
    max-width: 38em;
  }
  .hero__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0 0 1.8rem;
  }
  .hero__signals span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font-size: 0.88rem;
    font-weight: 700;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__note {
    margin: 1rem 0 0;
    color: #cfe3d7;
    font-size: 0.82rem;
  }
  .hero__media {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 8px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
  }
  .hero__media img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .hero__mediaCaption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    display: grid;
    gap: 0.2rem;
    padding: 0.8rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 8px;
    background: rgba(23, 50, 77, 0.82);
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 700;
    backdrop-filter: blur(8px);
  }
  .hero .btn--ghost {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  @media (max-width: 860px) {
    .hero {
      padding: 3.25rem 0;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero__media {
      max-width: 34rem;
    }
  }
  @media (max-width: 560px) {
    .hero__mediaCaption {
      position: static;
      border-radius: 0;
      border-right: 0;
      border-bottom: 0;
      border-left: 0;
      background: var(--c-navy);
    }
  }
</style>
