---
import type { Target } from '../data/types.ts';

interface Props {
  target: Target;
  closingNote: string;
}
const { target, closingNote } = Astro.props;
const telHref = target.phone ? `tel:${target.phone.replace(/-/g, '')}` : null;
const openingLines = target.openingHours
  ? target.openingHours.split('\n').filter((s) => s.trim().length > 0)
  : [];
const ratingDisplay =
  target.rating != null && target.reviewCount != null && target.reviewCount > 0
    ? `★${target.rating.toFixed(1)} / Googleレビュー ${target.reviewCount}件`
    : null;
const mapQuery = [target.name, target.address || target.area].filter(Boolean).join(' ');
const mapEmbedSrc = mapQuery
  ? `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`
  : null;
---
<section id="contact" class="contact">
  <div class="container">
    <div class="contact__grid">
      <div class="contact__intro">
        <p class="section-kicker">Contact</p>
        <h2 class="section-title">アクセス・お問い合わせ</h2>
        <p class="contact__note">{closingNote}</p>
        <div class="contact__cta">
          {telHref && (
            <a class="btn" href={telHref}>
              {target.phone} に電話する
            </a>
          )}
          {target.googleMapsUrl && (
            <a class="btn btn--ghost" href={target.googleMapsUrl} target="_blank" rel="noopener">
              Google Mapsで確認
            </a>
          )}
        </div>
      </div>
      <div class="card contact-card">
        {mapEmbedSrc && (
          <div class="map-embed" aria-label={`${target.name}周辺のGoogle Maps埋め込み`}>
            <iframe
              src={mapEmbedSrc}
              title={`${target.name}の地図`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        )}
        <dl class="info">
          <div class="info__row">
            <dt>会社名</dt>
            <dd>{target.name}</dd>
          </div>
          {target.address && (
            <div class="info__row">
              <dt>所在地</dt>
              <dd>{target.address}</dd>
            </div>
          )}
          {target.phone && (
            <div class="info__row">
              <dt>電話番号</dt>
              <dd>
                {telHref ? <a href={telHref}>{target.phone}</a> : target.phone}
              </dd>
            </div>
          )}
          {openingLines.length > 0 && (
            <div class="info__row">
              <dt>営業時間</dt>
              <dd>
                <ul class="hours">
                  {openingLines.map((line) => <li>{line}</li>)}
                </ul>
              </dd>
            </div>
          )}
          {ratingDisplay && (
            <div class="info__row">
              <dt>口コミ評価</dt>
              <dd>
                {ratingDisplay}
                {target.googleMapsUrl && (
                  <>
                    {' '}
                    <a href={target.googleMapsUrl} target="_blank" rel="noopener">
                      Google Mapsで見る
                    </a>
                  </>
                )}
              </dd>
            </div>
          )}
        </dl>
      </div>
    </div>
  </div>
</section>
<style>
  .contact {
    padding: 4.5rem 0;
    background: var(--c-bg-soft);
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 2rem;
    align-items: start;
  }
  .contact__note {
    margin: 0;
    color: var(--c-muted);
  }
  .contact-card {
    padding: 1.6rem;
  }
  .map-embed {
    overflow: hidden;
    margin: 0 0 1.35rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    background: var(--c-navy-soft);
  }
  .map-embed iframe {
    display: block;
    width: 100%;
    height: clamp(16rem, 34vw, 22rem);
    border: 0;
  }
  .info {
    margin: 0;
  }
  .info__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--c-border);
  }
  .info__row:first-child {
    padding-top: 0;
  }
  .info__row:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }
  .info dt {
    color: var(--c-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }
  .info dd {
    margin: 0;
    font-size: 0.98rem;
  }
  .hours {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    color: var(--c-text);
  }
  .contact__cta {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 820px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .info__row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
