---
interface ServiceItem {
  title: string;
  description: string;
}
interface Props {
  services: ServiceItem[];
  whyPoints: ServiceItem[];
}
const { services, whyPoints } = Astro.props;
---
<section class="services">
  <div class="container">
    <h2 class="section-title">対応工事</h2>
    <div class="grid grid--3">
      {services.map((s) => (
        <article class="card">
          <h3 class="card-title">{s.title}</h3>
          <p class="card-body">{s.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<section class="why">
  <div class="container">
    <h2 class="section-title">こんなお悩みありませんか?</h2>
    <div class="grid grid--2">
      {whyPoints.map((p) => (
        <article class="card card--soft">
          <h3 class="card-title">{p.title}</h3>
          <p class="card-body">{p.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .services {
    padding: 3.5rem 0 1rem;
  }
  .why {
    padding: 2.5rem 0 3.5rem;
  }
  .section-title {
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    margin: 0 0 1.5rem;
    padding-left: 0.75rem;
    border-left: 4px solid var(--c-accent);
  }
  .grid {
    display: grid;
    gap: 1rem;
  }
  .grid--3 {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .grid--2 {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .card-title {
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }
  .card-body {
    margin: 0;
    color: var(--c-text);
    font-size: 0.95rem;
  }
  .card--soft {
    background: #f7f3ea;
    border-color: #e4dfd0;
    box-shadow: none;
  }
</style>
