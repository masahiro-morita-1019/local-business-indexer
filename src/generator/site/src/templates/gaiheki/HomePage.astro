---
import ContactSection from '../../components/ContactSection.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import type { Target } from '../../data/types.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultGaihekiCopy } from './content.ts';

interface Props {
  target: Target;
}
const { target } = Astro.props;
const copy = defaultGaihekiCopy;
const title = `${target.name}|${target.area}の外壁塗装(サンプル)`;
const description = `${target.area}で外壁塗装を手がける${target.name}のご紹介サイト(サンプル)。`;
---
<BaseLayout title={title} description={description}>
  <header class="topbar">
    <div class="container topbar__inner">
      <span class="topbar__brand">{target.name}</span>
      <span class="topbar__hint">
        これは外壁塗装サンプルHPです。事実情報は Google マップから取得し、装飾コピーは汎用のたたき台です。
      </span>
    </div>
  </header>
  <Hero
    target={target}
    catchphrase={copy.catchphrase}
    subCatchphrase={copy.subCatchphrase}
  />
  <Services services={copy.services} whyPoints={copy.whyPoints} />
  <section class="local-note">
    <div class="container local-note__inner">
      <div>
        <p class="section-kicker">Local</p>
        <h2 class="section-title">{target.area}で外壁まわりを相談したい方へ</h2>
      </div>
      <p>
        住所、電話番号、営業時間、Google マップ情報など、確認できる事実情報を中心にまとめています。
        施工実績や保証内容など、事業者ごとに確認が必要な情報はこのサンプルでは断定していません。
      </p>
    </div>
  </section>
  <section class="flow">
    <div class="container">
      <p class="section-kicker">Flow</p>
      <h2 class="section-title">ご依頼の流れ</h2>
      <ol class="flow__list">
        {copy.flow.map((step) => (
          <li class="flow__item">
            <p class="flow__step">{step.step}</p>
            <p class="flow__desc">{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <ContactSection target={target} closingNote={copy.closingNote} />
  <footer class="footer">
    <div class="container footer__inner">
      <p>{target.name}</p>
      {target.address && <p class="footer__addr">{target.address}</p>}
      <p class="footer__note">
        本サイトは AI を用いたサンプルです。実在企業の情報を含みますが、文言の一部は汎用テンプレートです。
      </p>
    </div>
  </footer>
</BaseLayout>
<style>
  .topbar {
    background: #10263c;
    color: #ffffff;
    font-size: 0.85rem;
    padding: 0.65rem 0;
  }
  .topbar__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
  }
  .topbar__brand {
    font-weight: 600;
  }
  .topbar__hint {
    color: #cbd9d2;
  }
  .local-note {
    padding: 0 0 4rem;
  }
  .local-note__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 2rem;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--c-border);
  }
  .local-note p {
    margin: 0;
    color: var(--c-muted);
  }
  .flow {
    padding: 4rem 0 1rem;
    background: #ffffff;
  }
  .flow__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1rem;
  }
  .flow__item {
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: 8px;
    padding: 1.15rem 1.2rem;
  }
  .flow__step {
    margin: 0 0 0.25rem;
    color: var(--c-navy);
    font-weight: 800;
  }
  .flow__desc {
    margin: 0;
    font-size: 0.95rem;
  }
  .footer {
    background: var(--c-navy);
    color: #d7e3dc;
    padding: 2rem 0;
    font-size: 0.85rem;
  }
  .footer p {
    margin: 0 0 0.5rem;
  }
  .footer__addr {
    color: #b7c9c0;
  }
  .footer__note {
    color: #b7c9c0;
    font-size: 0.78rem;
  }
  @media (max-width: 760px) {
    .local-note__inner {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
