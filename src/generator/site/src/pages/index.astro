---
import { loadTargetsFile } from '../data/loadTargets.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const file = await loadTargetsFile();
const sorted = [...file.targets].sort((a, b) => b.outreachScore - a.outreachScore);
const generatedAt = new Date(file.generatedAt).toLocaleString('ja-JP');
const filterCategory = file.filter.category ?? '全業種';
---
<BaseLayout title="プレビュー一覧 — local-business-indexer">
  <main class="container preview">
    <header class="preview__header">
      <p class="preview__eyebrow">Phase 2: HP 生成プレビュー</p>
      <h1 class="preview__title">サンプルHP一覧</h1>
      <p class="preview__meta">
        <span>業種: {filterCategory}</span>
        <span>最低優先度: {file.filter.minPriority}</span>
        <span>件数: {file.count}</span>
        <span>データ取得: {generatedAt}</span>
      </p>
      <p class="preview__note">
        各カードをクリックすると、その企業向けに生成したサンプルHPが開きます。<br />
        ⚠️ 装飾コピーは汎用テンプレ。電話番号・住所・レビューは Google マップ実データです。
      </p>
    </header>

    {sorted.length === 0 && (
      <div class="empty">
        <p>表示する企業がありません。</p>
        <pre>pnpm indexer build-data --category "外壁塗装" --min-priority 中</pre>
      </div>
    )}

    <ul class="grid">
      {sorted.map((t) => (
        <li class="grid__item">
          <a class="card preview-card" href={`/${t.placeId}`}>
            <div class="preview-card__row">
              <h2 class="preview-card__title">{t.name}</h2>
              <span class={`badge badge--${t.outreachPriority}`}>{t.outreachPriority}</span>
            </div>
            <p class="preview-card__meta">
              {t.area} ・ {t.category} ・ {t.websiteClass === 'none' ? 'HP無し' : 'SNSのみ'}
            </p>
            {t.address && <p class="preview-card__addr">{t.address}</p>}
            <p class="preview-card__row preview-card__row--bottom">
              <span class="preview-card__phone">📞 {t.phone || '電話番号不明'}</span>
              <span class="preview-card__score">score {t.outreachScore}</span>
            </p>
            {t.outreachReasons && (
              <p class="preview-card__reasons">{t.outreachReasons}</p>
            )}
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
<style>
  .preview {
    padding: 3rem 0 4rem;
  }
  .preview__header {
    margin-bottom: 2rem;
  }
  .preview__eyebrow {
    margin: 0 0 0.25rem;
    color: var(--c-muted);
    letter-spacing: 0.06em;
    font-size: 0.9rem;
  }
  .preview__title {
    margin: 0 0 1rem;
    font-size: clamp(1.7rem, 4vw, 2.2rem);
  }
  .preview__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    color: var(--c-muted);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }
  .preview__note {
    margin: 0;
    color: var(--c-muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }
  .empty {
    background: #fff8e1;
    border: 1px dashed #d9c66a;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
  }
  .empty pre {
    background: #1d1d1f;
    color: #f5f5f4;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    overflow-x: auto;
  }
  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  }
  .preview-card {
    display: block;
    text-decoration: none;
    color: var(--c-text);
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }
  .preview-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  }
  .preview-card__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .preview-card__row--bottom {
    margin-top: 0.75rem;
    color: var(--c-muted);
    font-size: 0.88rem;
  }
  .preview-card__title {
    margin: 0;
    font-size: 1.05rem;
  }
  .preview-card__meta {
    color: var(--c-muted);
    font-size: 0.85rem;
    margin: 0.35rem 0 0;
  }
  .preview-card__addr {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    color: var(--c-muted);
  }
  .preview-card__reasons {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    color: #8c8a83;
    line-height: 1.5;
  }
  .badge {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .badge--高 {
    background: #fde2e2;
    color: #b32020;
  }
  .badge--中 {
    background: #fff1cc;
    color: #8a6d11;
  }
  .badge--低 {
    background: #e3eaf2;
    color: #4f637b;
  }
</style>
