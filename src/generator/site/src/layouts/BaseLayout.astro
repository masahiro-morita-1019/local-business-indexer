---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex,nofollow" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    <style is:global>
      :root {
        --c-bg: #f6f8f5;
        --c-bg-soft: #edf3ec;
        --c-text: #17211b;
        --c-muted: #64736a;
        --c-accent: #1f6f4a;
        --c-accent-fg: #ffffff;
        --c-accent-soft: #dfeee4;
        --c-navy: #17324d;
        --c-navy-soft: #e7eef3;
        --c-warm: #f7f1e7;
        --c-border: #dbe4dc;
        --c-card: #ffffff;
        --shadow-card: 0 16px 40px rgba(23, 50, 77, 0.08);
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--c-bg);
        color: var(--c-text);
        font-family:
          -apple-system, BlinkMacSystemFont, 'Hiragino Sans', 'Yu Gothic UI', 'Meiryo',
          sans-serif;
        line-height: 1.7;
      }
      a {
        color: var(--c-accent);
      }
      .container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.25rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 3rem;
        padding: 0.85rem 1.35rem;
        border-radius: 8px;
        background: var(--c-accent);
        color: var(--c-accent-fg);
        text-decoration: none;
        font-weight: 700;
        line-height: 1.3;
        box-shadow: var(--shadow-card);
      }
      .btn--ghost {
        background: #ffffff;
        color: var(--c-navy);
        border: 1px solid var(--c-border);
        box-shadow: none;
      }
      .card {
        background: var(--c-card);
        border: 1px solid var(--c-border);
        border-radius: 8px;
        padding: 1.25rem 1.5rem;
        box-shadow: var(--shadow-card);
      }
      h1,
      h2,
      h3 {
        line-height: 1.35;
      }
      p {
        overflow-wrap: anywhere;
      }
      .section-kicker {
        margin: 0 0 0.45rem;
        color: var(--c-accent);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .section-title {
        margin: 0 0 1rem;
        color: var(--c-text);
        font-size: clamp(1.45rem, 3vw, 2rem);
      }
      .section-lede {
        max-width: 44rem;
        margin: 0 0 1.75rem;
        color: var(--c-muted);
        font-size: 0.98rem;
      }
      @media (max-width: 560px) {
        .container {
          padding: 0 1rem;
        }
        .btn {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
