# Google Maps Platform - Places API (New)
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Notion Integration
# https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxx

# Notion DB を作成する親ページの ID (URL の末尾の32文字英数)
# setup-notion-db を実行するときに必要
NOTION_PARENT_PAGE_ID=

# setup-notion-db 実行後に出力された database_id をここに貼り付け
NOTION_DATABASE_ID=

# Anthropic API (Phase 4 以降の文面生成で使用)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx

# ---- 差出人情報 (Phase 4 以降の文面生成で使用) ----
# 屋号未登録の場合は個人名でOK。決まったら書き換えるだけで全文面に反映
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_TITLE=Webサイト制作
OUTREACH_SENDER_EMAIL=
OUTREACH_SENDER_PHONE=
OUTREACH_SENDER_ADDRESS=
# 自分のポートフォリオ/名刺サイトURL (例: ~/code/profile のVercel URL)
OUTREACH_SENDER_PORTFOLIO_URL=

# 営業時の「装備・スタンス」を自由文で記述(Show-Don't-Tell型の文面生成のため)
# 未設定時は「電話前にサンプルHPを作成済み」前提のデフォルト文が使われる
# 例:
# OUTREACH_PITCH_CONTEXT="電話前に相手企業向けのサンプルHPを1ページ作成済み。電話の目的は『メールでURLを送る了承を取ること』。気に入らなければそれで終了で問題なし。"
OUTREACH_PITCH_CONTEXT=

# ---- Cloudflare Pages (Phase 3 デプロイで使用) ----
# https://dash.cloudflare.com/profile/api-tokens で Pages:Edit 権限のトークンを発行
CLOUDFLARE_API_TOKEN=
# ダッシュボード右サイドバー or URL の dash.cloudflare.com/<id> から取得
CLOUDFLARE_ACCOUNT_ID=
# Cloudflare Pages のプロジェクト名(初回 deploy 時に自動作成される)。英数とハイフンのみ
CLOUDFLARE_PAGES_PROJECT=local-business-samples
